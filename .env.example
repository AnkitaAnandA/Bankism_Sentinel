ENV=development
DATABASE_URL=sqlite:///./bankism.db
# Generate independent random values (required in production; at least 32 chars)
INTENT_HMAC_KEY=
SESSION_SIGNING_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional explicit regex for controlled preview origins, never broad wildcards
ALLOWED_ORIGIN_REGEX=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT=2.5
LLM_DAILY_BUDGET=1000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EVALUATE=3
SERVE_FRONTEND=false
